# Copy to .env and adjust for your machine:  cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# PostgreSQL (preferred). Matches the docker-compose service below.
DATABASE_URL=postgres://pms:pms@localhost:5432/property_management
#
# SQLite fallback -- zero setup, but the database-level exclusion constraint that
# prevents double-booking is skipped (see README > Double-booking prevention).
# DATABASE_URL=sqlite:///db.sqlite3

# JWT lifetimes (minutes / days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
